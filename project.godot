; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="godot-pc-template"
config/version="0.1.0"
run/main_scene="res://scenes/bootstrap.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="godot-pc-template"
config/auto_accept_quit=false
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://autoload/game_config.gd"
Settings="*res://autoload/settings.gd"
SaveManager="*res://autoload/save_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
WindowManager="*res://autoload/window_manager.gd"
InputManager="*res://autoload/input_manager.gd"
SceneManager="*res://autoload/scene_manager.gd"
App="*res://autoload/app.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=960
window/size/min_height=540

[gui]

theme/custom="res://ui/theme/default_theme.tres"

